{
  "name": "hightop-challenge",
  "version": "0.1.0",
  "private": true,
  "description": "A mobile website that allows users to compete with each other on trivia and predictions.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:god-mode-join": "vitest run tests/god-mode-join-contract.test.ts tests/lib.join-venue-entry.test.ts tests/api.join.venue-profile-with-account.test.ts tests/api.join.profile.test.ts tests/lib.venue-presence-god-mode.test.ts",
    "test:venue-fk-guard": "vitest run tests/lib.venue-fk-cascade-guard.test.ts",
    "test:pwa-contract": "vitest run tests/pwa-contract.test.ts",
    "test:venue-screen-overflow": "node scripts/verify-venue-screen-overflow.mjs",
    "category-blitz:verify-mobile-shell": "node --env-file=.env.local --conditions react-server --import tsx scripts/verify-category-blitz-mobile-shell.cjs",
    "auth:smoke": "node scripts/auth-smoke.cjs",
    "category-blitz:build": "node --env-file=.env.local scripts/build-category-blitz-letter-index.cjs",
    "category-blitz:build:dry-run": "node --env-file=.env.local scripts/build-category-blitz-letter-index.cjs --dry-run",
    "category-blitz:simulate": "node --env-file=.env.local --conditions react-server --import tsx scripts/simulate-category-blitz.cjs",
    "category-blitz:simulate:llm": "node --env-file=.env.local --conditions react-server --import tsx scripts/simulate-category-blitz.cjs --llm",
    "trivia:generate": "node --env-file=.env.local scripts/generate-trivia-questions.cjs",
    "trivia:generate:nightly": "node --env-file=.env.local scripts/generate-trivia-nightly.cjs --total 100",
    "trivia:check": "node scripts/import-trivia-questions.cjs --dir data/trivia/categories --check",
    "trivia:import": "node --env-file=.env.local scripts/import-trivia-questions.cjs --dir data/trivia/categories",
    "trivia:import:prune": "node --env-file=.env.local scripts/import-trivia-questions.cjs --dir data/trivia/categories",
    "trivia:sync": "node --env-file=.env.local scripts/sync-local-trivia.cjs",
    "trivia:sync:dry-run": "node --env-file=.env.local scripts/sync-local-trivia.cjs --dry-run",
    "trivia:duplicates:audit": "node --env-file=.env.local scripts/cleanup-trivia-duplicates.cjs",
    "trivia:duplicates:fix:db": "node --env-file=.env.local scripts/cleanup-trivia-duplicates.cjs --apply-db",
    "trivia:duplicates:fix:local": "node scripts/cleanup-trivia-duplicates.cjs --apply-local",
    "trivia:duplicates:fix": "node --env-file=.env.local scripts/cleanup-trivia-duplicates.cjs --apply-db --apply-local",
    "trivia:bank:check": "node scripts/backfill-trivia-question-bank.cjs --check",
    "trivia:bank:backfill": "node --env-file=.env.local scripts/backfill-trivia-question-bank.cjs",
    "live-trivia:generate": "node --env-file=.env.local scripts/generate-live-trivia-questions.cjs",
    "live-trivia:generate:nightly": "node --env-file=.env.local scripts/generate-live-trivia-nightly.cjs --total 50",
    "live-trivia:check": "node scripts/import-trivia-questions.cjs --live-dir data/live-trivia/categories --check",
    "live-trivia:import": "node --env-file=.env.local scripts/import-trivia-questions.cjs --live-dir data/live-trivia/categories",
    "live-trivia:randomness:audit": "node --conditions react-server --import tsx scripts/audit-live-trivia-randomness.cjs",
    "live-trivia:future-reseed:dry-run": "node --env-file=.env.local --conditions react-server --import tsx scripts/reseed-live-trivia-future.cjs",
    "live-trivia:future-reseed:apply": "node --env-file=.env.local --conditions react-server --import tsx scripts/reseed-live-trivia-future.cjs --apply",
    "headshots:sync": "node scripts/sync-headshots.js",
    "apisports:probe:nba": "node --env-file=.env.local scripts/probe-apisports-nba.cjs",
    "test:bingo-nfl": "vitest run tests/lib.sportsBingo.balldontlie-date-params.test.ts tests/lib.sportsBingo.request-caching.test.ts tests/lib.league-season-status.test.ts tests/api.bingo.leagues.test.ts tests/lib.league-availability.test.ts tests/lib.sportsBingo-odds.test.ts tests/lib.sportsBingo.nfl-core-squares.test.ts tests/lib.sportsBingoOdds.nfl-player-props.test.ts tests/lib.sportsBingo.nfl-prop-mix.test.ts tests/lib.sportsBingo.nfl-settlement.test.ts tests/lib.sportsBingo.nfl-settlement-confidence.test.ts tests/lib.sportsBingo.nfl-flavor-squares.test.ts tests/lib.sportsBingo.nfl-quarter-recalibration.test.ts tests/lib.sportsBingoCorrelation.test.ts tests/lib.sportsBingo.win-rate-calibration.test.ts tests/lib.sportsBingo.nfl-star-index.test.ts tests/lib.sportsBingo.nfl-star-tilt.test.ts tests/lib.sportsBingo.nfl-star-index-freshness.test.ts tests/lib.sportsBingo.nfl-safety-attribution.test.ts",
    "test:bingo-mlb": "vitest run tests/lib.sportsBingo.mlb-event-rebalance.test.ts tests/lib.sportsBingo.mlb-win-rate-calibration.test.ts tests/lib.sportsBingoOdds.mlb-player-props.test.ts tests/lib.sportsBingo.mlb-star-index.test.ts tests/lib.sportsBingo.mlb-star-tilt.test.ts tests/lib.sportsBingo.mlb-star-index-freshness.test.ts tests/lib.sportsBingo.sport-path-keys.test.ts tests/lib.sportsBingo.balldontlie-score-normalizer.test.ts tests/lib.sportsBingo.mlb-row-shape.test.ts",
    "bingo:probe:nfl": "node --env-file=.env.local scripts/probe-nfl-bingo.cjs",
    "bingo:probe:nfl-flavor": "node --env-file=.env.local --conditions react-server --import tsx scripts/probe-nfl-flavor-squares.cjs",
    "bingo:validate:nfl": "node --env-file=.env.local --conditions react-server --import tsx scripts/validate-nfl-bingo-grading.cjs",
    "bingo:validate:mlb": "node --env-file=.env.local --conditions react-server --import tsx scripts/validate-mlb-bingo-grading.cjs",
    "bingo:measure:mlb": "node --env-file=.env.local scripts/measure-mlb-event-rates.cjs",
    "bingo:measure:nfl-quarters": "node --env-file=.env.local scripts/measure-nfl-quarter-rates.cjs",
    "bingo:calibrate:nfl": "node --env-file=.env.local --conditions react-server --import tsx scripts/calibrate-nfl-square-families.cjs",
    "bingo:stars:nfl": "node --env-file=.env.local --conditions react-server --import tsx scripts/refresh-nfl-star-index.cjs",
    "bingo:stars:nfl:dry-run": "node --env-file=.env.local --conditions react-server --import tsx scripts/refresh-nfl-star-index.cjs --dry-run",
    "bingo:stars:mlb": "node --env-file=.env.local --conditions react-server --import tsx scripts/refresh-mlb-star-index.cjs",
    "bingo:stars:mlb:dry-run": "node --env-file=.env.local --conditions react-server --import tsx scripts/refresh-mlb-star-index.cjs --dry-run",
    "bingo:baseline": "node --env-file=.env.local --conditions react-server --import tsx scripts/baseline-bingo-win-rates.cjs",
    "bingo:simulate": "node --env-file=.env.local --conditions react-server --import tsx scripts/simulate-bingo-boards.cjs",
    "bingo:simulate:backtest": "node --env-file=.env.local --conditions react-server --import tsx scripts/simulate-bingo-boards.cjs --backtest",
    "live-showdown:seed": "node --env-file=.env.local --import tsx scripts/seedLiveShowdownPool.ts",
    "trivia:restore-speed": "node --env-file=.env.local scripts/restore-deleted-speed-trivia.cjs",
    "landmark:images": "node --env-file=.env.local scripts/enrich-landmark-images.cjs",
    "rewards:audit-legacy-cadences": "node --env-file=.env.local scripts/audit-legacy-recurring-cadences.cjs",
    "landmark:images:dry-run": "node --env-file=.env.local scripts/enrich-landmark-images.cjs --dry-run",
    "landmark:review": "node scripts/review-trivia-images.cjs",
    "pwa:icons": "node scripts/generate-pwa-icons.cjs",
    "billing:phase1-audit": "node --env-file=.env.local scripts/phase1-audit.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewSerulneck/Hightop-Challenge.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AndrewSerulneck/Hightop-Challenge/issues"
  },
  "homepage": "https://github.com/AndrewSerulneck/Hightop-Challenge#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "@supabase/supabase-js": "^2.95.3",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.564.0",
    "next": "^16.1.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "stripe": "^22.3.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.24",
    "d3-geo": "^3.1.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "topojson-client": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "us-atlas": "^3.0.1",
    "vitest": "^4.0.18",
    "world-atlas": "^2.0.2"
  }
}
