NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DISABLE_GEOFENCE=false
VENUE_PRESENCE_ENFORCEMENT=1
VENUE_PRESENCE_TTL_MS=180000
VENUE_PRESENCE_MIN_RADIUS_METERS=300
VENUE_PRESENCE_ACCURACY_BUFFER_MIN_METERS=120
VENUE_PRESENCE_ACCURACY_BUFFER_DEFAULT_METERS=320
VENUE_PRESENCE_ACCURACY_BUFFER_MAX_METERS=5000
VENUE_PRESENCE_ACCURACY_MULTIPLIER=1.5
VENUE_PRESENCE_FALSE_POSITIVE_WINDOW_MS=300000
VENUE_PRESENCE_DIAGNOSTICS_WINDOW_MINUTES=60
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ADS_BUCKET=advertisements
POLYMARKET_API_KEY=
POLYMARKET_API_URL=https://gamma-api.polymarket.com/markets
POLYMARKET_MARKET_LIMIT=20
POLYMARKET_SCAN_LIMIT=1000
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_SPORT_KEYS=
ODDS_API_LOOKAHEAD_HOURS=168
ODDS_API_SCORES_DAYS=3
ODDS_API_CACHE_TTL_MS=120000
BALLDONTLIE_API_KEY=
BALLDONTLIE_API_BASE_URL=https://api.balldontlie.io
BALLDONTLIE_GAME_LOOKUP_WINDOW_DAYS=1
THESPORTSDB_API_KEY=
THESPORTSDB_API_BASE_URL=https://www.thesportsdb.com/api/v1/json
CRON_SECRET=
ADMIN_LOGIN_USERNAME=
ADMIN_LOGIN_PASSWORD=
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BASE_BRANCH=main
GITHUB_EXPORT_DRAFT_PR=false
FANTASY_WINNER_POINTS=250
# Bypasses Category Blitz's <3-player scoring gate so a solo dev-server tester
# can see real grading/leaderboard behavior end-to-end. Never set in production.
CATEGORY_BLITZ_ALLOW_SOLO_SCORING=false

# ── Phase 6: domain split (apex → marketing /info, play. → the game) ──
# Master flag. Leave off (single-origin) until DNS for the play host is live.
NEXT_PUBLIC_DOMAIN_SPLIT_ENABLED=false
# Hosts (no scheme, no port). www. of the apex is treated as apex.
NEXT_PUBLIC_APEX_HOST=hightopchallenge.com
NEXT_PUBLIC_PLAY_HOST=play.hightopchallenge.com
# Absolute bases used to build cross-host links/redirects (default to https://<host>).
NEXT_PUBLIC_SITE_URL=https://hightopchallenge.com
NEXT_PUBLIC_PLAY_URL=https://play.hightopchallenge.com
# Parent-domain cookie scope so a player session survives apex ↔ play. navigation.
# Leave empty for host-only cookies (required for localhost/preview).
NEXT_PUBLIC_COOKIE_DOMAIN=

# ── Phase 5: PWA install prompt (Bingo landscape "Add to Home Screen") ──
# Off = fully inert (no listener, no coach card). Do NOT enable before the domain split
# above is live — see docs/pwa-install-rollout-runbook.md.
NEXT_PUBLIC_PWA_INSTALL_PROMPT_ENABLED=false

# ── Phase 8: partner welcome email (sent once, on Stripe checkout.session.completed) ──
# Resend API key. Leave empty to no-op (welcome email is skipped, billing sync is unaffected).
RESEND_API_KEY=
# Must be a domain verified in Resend (hightopchallenge.com already is). Falls back
# to a no-reply@ address on that domain if unset.
EMAIL_FROM_ADDRESS="Hightop Challenge <no-reply@hightopchallenge.com>"

# ── Prop Bingo: season gating + NFL activation (docs/prop-bingo-nfl-plan.md) ──
# Off = today's always-clickable league picker, fully inert. On = out-of-season leagues are
# greyed out with a return month, and /api/bingo/games + board creation reject them server-side.
NEXT_PUBLIC_BINGO_SEASON_GATING_ENABLED=false
# The single NFL activation switch, independent of season gating. Off = NFL reads "Coming soon"
# in the picker and NFL board requests are rejected server-side, regardless of the real season.
# Do NOT flip until Phase 4 (NFL grading) has landed — Phases 2-3 give NFL real market-derived
# core squares, player props and team/game squares, but NO NFL settlement: every NFL square
# currently voids at Final instead of being graded.
NEXT_PUBLIC_BINGO_NFL_ENABLED=false
# Phase 2 scoring model (see lib/sportsBingoOdds.ts). Leave unset unless recalibrating: the
# game-total sigma is derived from these two, so they are not independent knobs.
# BINGO_NFL_MARGIN_SIGMA=13.5
# BINGO_NFL_TEAM_TOTAL_SIGMA=10
# Phase 3 player props. The kill switch defaults ON: it removes the whole play-by-play square
# family (first TD, first score is a FG, defensive/ST TD, 4th-down conversion, 50+ yard TD),
# which are the squares that need /nfl/v1/plays to settle. Phase 8b widened what it gates: the
# whole Tier-3 clock-and-score family (first score inside N minutes, scores in the final minute of
# a half, lead changes, comebacks, two-point tries, safeties, goal-line TDs) rides the same walk.
# BINGO_NFL_PLAY_BY_PLAY_SQUARES_ENABLED=true
# Phase 8b flavor squares. How many Tier-1 (/nfl/v1/team_stats) squares a board may carry, in
# total and from one team's box score. The board cap is 3 because it is still unknown whether BDL
# populates team_stats mid-game or only at Final (Phase 8a Q1, unanswerable until a real NFL game
# is in progress — earliest 2026-09-11). Final-only is the conservative reading: a board of squares
# that all settle at the whistle is dead for three hours. Raise this once the live check confirms
# mid-game population; see docs/prop-bingo-nfl-plan.md.
# BINGO_NFL_TIER1_MAX_PER_BOARD=3
# BINGO_NFL_TIER1_MAX_PER_TEAM=2
# How much of the book's hold to shave off a one-sided milestone price (anytime TD / first TD).
# A flat factor, not field normalization — see lib/sportsBingoOdds.ts. Phase 5 should validate it.
# BINGO_NFL_MILESTONE_DEVIG_FACTOR=0.92
# Player props are one call per game and live-only; this is their own cache, separate from the
# slate-wide odds fetch inside loadGameCatalog.
# BINGO_NFL_PLAYER_PROPS_CACHE_MS=60000
#
# ── Phase 5: win-rate calibration (all leagues, not just NFL) ──
# The target board win rate and the band around it. 0.25 ± 0.05 is the plan's ask #4, and it
# applies to NBA/WNBA/MLB as well as NFL (plan decision 1). This number only means what the
# estimator measuring it means: it moved from 0.42 to 0.25 in the same change that replaced the
# independent-coin-flip estimator with the correlated one in lib/sportsBingoCorrelation.ts, so the
# two are not comparable. Verify with `npm run bingo:simulate -- --backtest` before moving it.
# BINGO_BOARD_TARGET_WIN_RATE=0.25
# BINGO_BOARD_TARGET_TOLERANCE=0.05
# Probability band a core-market square (spread / game total / team total) must sit in to be
# offered to a board ahead of the ladder's dead-weight outer rungs. A preference, not a filter.
# BINGO_CORE_SQUARE_MIN_PROBABILITY=0.18
# BINGO_CORE_SQUARE_MAX_PROBABILITY=0.82
# How many squares on one five-square line may share a single directional bet (margin / total /
# closeness). Four aligned squares plus the free centre is how a "25%" board becomes a 45% board.
# BINGO_LINE_MAX_SAME_DIRECTION=3
# Correlation strengths, all documented inline in lib/sportsBingoCorrelation.ts with the pairing
# each one targets. Leave unset unless recalibrating against a backtest.
# BINGO_CORR_PLAYER_PROP_SYSTEMATIC=0.7
# BINGO_CORR_HALFTIME_SYSTEMATIC=0.7
# BINGO_CORR_QUARTER_SYSTEMATIC=0.5
# BINGO_CORR_DIRECTION_MIN_SYSTEMATIC=0.8
