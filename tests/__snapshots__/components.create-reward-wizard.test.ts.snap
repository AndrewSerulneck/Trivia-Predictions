exports[`CreateRewardWizard — admin variant, no new props > renders the same markup at every step, with no transition wrapper > terms 1`] = `"<div class="space-y-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><div class="space-y-4"><div><p class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-600">How is this reward won?</p><div class="grid grid-cols-2 gap-2"><button type="button" class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600 border-indigo-500 bg-indigo-50 text-indigo-700">Points target</button><button type="button" class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600 ">Winner of the game</button></div><p class="mt-1.5 text-xs text-slate-500">Anyone who reaches the points target gets this prize.</p></div><div><p class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-600">Points target</p><div class="grid grid-cols-4 gap-2"><button type="button" class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600 ">300</button><button type="button" class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600 border-indigo-500 bg-indigo-50 text-indigo-700">500</button><button type="button" class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600 ">750</button><button type="button" class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600 ">1,000</button></div><input min="1" placeholder="Custom target" class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" type="number" value=""><p class="mt-1.5 text-xs text-slate-500">Earn 500 points in Live Trivia</p></div><div><p class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-600">How many, how often?</p><p class="text-base leading-8 text-slate-900">I want to make <select aria-label="Number of rewards" class="mx-1 inline-block rounded-lg border border-indigo-300 bg-indigo-50 px-2 py-1 text-sm font-bold text-indigo-800 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option><option value="7">7</option><option value="8">8</option><option value="9">9</option><option value="10">10</option><option value="12">12</option><option value="15">15</option><option value="20">20</option><option value="25">25</option></select> of these rewards available every <select aria-label="How often" class="mx-1 inline-block rounded-lg border border-indigo-300 bg-indigo-50 px-2 py-1 text-sm font-bold text-indigo-800 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"><option value="weekly">week</option><option value="monthly">month</option><option value="yearly">year</option></select>.</p></div><div class=""><div class="flex items-center gap-3"><button type="button" aria-busy="false" class="tp-clean-button inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-xl px-5 py-3 text-sm font-black transition-all disabled:opacity-40 focus-visible:outline-none focus-visible:ring-2 border border-slate-300 bg-white text-slate-700 shadow-sm hover:bg-slate-50 focus-visible:ring-indigo-300"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left h-4 w-4" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>Live Trivia Challenge</button><button type="button" aria-busy="false" class="tp-clean-button inline-flex flex-1 items-center justify-center gap-1.5 rounded-xl font-black transition-all disabled:opacity-40 focus-visible:outline-none focus-visible:ring-2 min-h-[44px] px-6 py-3 text-base bg-indigo-600 text-white hover:bg-indigo-700 focus-visible:ring-indigo-300">Next: Offer a Prize<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-4 w-4" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button></div></div></div></div>"`;
