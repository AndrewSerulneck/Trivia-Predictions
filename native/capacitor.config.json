{
  "appId": "com.hightopchallenge.app",
  "appName": "Hightop Challenge",
  "webDir": "www",
  "server": {
    "url": "https://play.hightopchallenge.com",
    "allowNavigation": [
      "play.hightopchallenge.com",
      "hightopchallenge.com"
    ]
  },
  "ios": {
    "appendUserAgent": "HightopChallengeApp/1.0.0 (ios)",
    "contentInset": "never",
    "backgroundColor": "#020617"
  },
  "android": {
    "appendUserAgent": "HightopChallengeApp/1.0.0 (android)",
    "backgroundColor": "#020617"
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#020617"
    },
    "SystemBars": {
      "style": "DARK"
    },
    "HightopShell": {
      "offlinePage": "offline.html",
      "openInBrowser": {
        "host": "hightopchallenge.com",
        "paths": [
          "/",
          "/info",
          "/faqs",
          "/advertise",
          "/owner/signup",
          "/owner/register",
          "/owner/billing/setup",
          "/admin"
        ]
      }
    }
  },
  "backgroundColor": "#020617"
}
